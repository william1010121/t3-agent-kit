{
  "name": "@t3-agent-kit/checkpoint",
  "version": "0.0.0",
  "description": "T3 Code's git checkpoints: snapshot a workspace into hidden refs, diff and restore turns",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "imports": {
    "#shared/*": "./src/_shared/*.ts",
    "#provider-core/server/*": "./src/_shared/provider-core/*.ts",
    "#source-control-core/server/*": "./src/_shims/source-control-core/*.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "effect-tsgo tsrs --noEmit"
  },
  "dependencies": {
    "@t3-agent-kit/contracts": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:"
  },
  "optionalDependencies": {
    "ffi-rs": "1.3.2"
  }
}
