{
  "name": "@t3-agent-kit/client-runtime",
  "version": "0.0.0",
  "description": "T3 Code's client connection runtime: environment connections, reconnect and wakeups, RPC over WebSocket, relay",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./connection": {
      "types": "./src/connection/index.ts",
      "import": "./src/connection/index.ts"
    },
    "./environment": {
      "types": "./src/environment/index.ts",
      "import": "./src/environment/index.ts"
    },
    "./rpc": {
      "types": "./src/rpc/index.ts",
      "import": "./src/rpc/index.ts"
    },
    "./relay": {
      "types": "./src/relay/index.ts",
      "import": "./src/relay/index.ts"
    },
    "./clock": {
      "types": "./src/clock.ts",
      "import": "./src/clock.ts"
    },
    "./state/environmentHttpAuth": {
      "types": "./src/state/environmentHttpAuth.ts",
      "import": "./src/state/environmentHttpAuth.ts"
    },
    "./state/runtime": {
      "types": "./src/state/runtime.ts",
      "import": "./src/state/runtime.ts"
    },
    "./state/server": {
      "types": "./src/state/server.ts",
      "import": "./src/state/server.ts"
    },
    "./state/session": {
      "types": "./src/state/session.ts",
      "import": "./src/state/session.ts"
    },
    "./state/query-persistence": {
      "types": "./src/state/queryPersistence.ts",
      "import": "./src/state/queryPersistence.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "effect-tsgo tsrs --noEmit"
  },
  "dependencies": {
    "@t3-agent-kit/contracts": "workspace:*",
    "@t3-agent-kit/shared": "workspace:*",
    "effect": "catalog:",
    "gt-i18n": "1.0.40"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:"
  }
}
